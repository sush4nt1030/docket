<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS is strongly recommended. Plain http:// is allowed only so you can test against a
     Docket server on your own Wi-Fi (e.g. http://192.168.1.20:3000). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
